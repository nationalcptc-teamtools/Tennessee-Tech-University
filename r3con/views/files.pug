doctype html
html(data-bs-theme='dark')
  head
    include head
  body
    header
      include navbar
    .container.mt-3
      .d-flex.justify-content-between.align-items-center.mb-4
        h2.text-light Files
        button.btn.btn-danger(type='button' onclick='uploadFile();')
          i.fas.fa-upload.me-2
          | Upload File
      
      // Search and Filter Controls
      .row.mb-3
        .col-md-8
          .d-flex.align-items-center.mb-2
            label.form-label.text-light.me-2 Search:
            input.form-control.me-2#searchInput(type='text' placeholder='Search files by name, tags, description...' value=search)
            button.btn.btn-outline-secondary.me-2(onclick='applySearch()')
              i.fas.fa-search.me-1
              | Search
            button.btn.btn-outline-danger(onclick='clearFilters()')
              i.fas.fa-times.me-1
              | Clear
        .col-md-4
          .d-flex.align-items-center
            label.form-label.text-light.me-2 Sort by:
            select.form-select.me-2#sortField(style='width: auto;')
              option(value='created_at' selected=currentSort.field === 'created_at') Date Uploaded
              option(value='original_name' selected=currentSort.field === 'original_name') Name
              option(value='file_size' selected=currentSort.field === 'file_size') Size
              option(value='mime_type' selected=currentSort.field === 'mime_type') Type
              option(value='tags' selected=currentSort.field === 'tags') Tags
            select.form-select#sortOrder(style='width: auto;')
              option(value='DESC' selected=currentSort.order === 'DESC') Desc
              option(value='ASC' selected=currentSort.order === 'ASC') Asc
      
      // Filter Controls
      .row.mb-3
        .col-md-6
          .mb-2
            label.form-label.text-light Filter by Tag:
            select.form-select#filterTag
              option(value='') All Tags
              for tag in filterOptions.tags
                option(value=tag selected=filters.tag === tag)= tag
        .col-md-6
          .mb-2
            .d-flex.align-items-center
              label.form-label.text-light.me-2 Quick Actions:
              button.btn.btn-sm.btn-outline-warning(onclick='showCurlInstructions()')
                i.fas.fa-terminal.me-1
                | Show cURL
      
      // Files Grid
      .row.g-3#filesGrid
        for file in files
          .col-12.col-md-6.col-lg-4.col-xl-3
            .card.h-100.border-secondary
              .card-header.d-flex.justify-content-between.align-items-center.bg-dark.border-secondary
                .d-flex.align-items-center
                  i.fas.fa-file.text-danger.me-2
                  span.badge.bg-danger= file.mime_type.split('/')[0].toUpperCase()
                // Dropdown removed; actions moved to card body
              
              .card-body.bg-dark
                .mb-2
                  strong.text-light File:
                  br
                  code.text-info= file.original_name
                
                .mb-2
                  strong.text-light Size:
                  br
                  span.text-muted= file.formattedSize
                
                if file.tags
                  .mb-2
                    strong.text-light Tags:
                    br
                    for tag in file.tagList
                      span.badge.bg-danger.me-1= tag
                
                if file.description
                  .mb-2
                    strong.text-light Description:
                    br
                    small.text-muted= file.description
                
                .mb-2
                  strong.text-light Uploaded:
                  br
                  small.text-muted= new Date(file.created_at).toLocaleString()
                
                if file.uploaded_by
                  .mb-2
                    strong.text-light By:
                    br
                    small.text-muted= file.uploaded_by
                
                .mt-3
                  .btn-group.w-100(role='group')
                    a.btn.btn-sm.btn-outline-danger(href=file.downloadUrl)
                      i.fas.fa-download.me-1
                      | Download
                    button.btn.btn-sm.btn-outline-secondary(type='button' onclick=`copyToClipboard('${file.curlUrl}')`)
                      i.fas.fa-copy.me-1
                      | Copy URL
                  .btn-group.w-100.mt-1(role='group')
                    button.btn.btn-sm.btn-outline-warning(type='button' onclick=`copyCurlCommand('${file.curlUrl}', '${file.original_name}')`)
                      i.fas.fa-terminal.me-1
                      | Copy cURL
                  .btn-group.w-100.mt-1(role='group')
                    button.btn.btn-sm.btn-outline-danger(type='button' onclick=`deleteFile(${file.id})`)
                      i.fas.fa-trash.me-1
                      | Delete

      // Empty state
      if files.length === 0
        .text-center.py-5
          i.fas.fa-file.fa-3x.text-muted.mb-3
          h4.text-muted No files found
          p.text-muted Click "Upload File" to get started

    include scripts
    script.
      function uploadFile() {
        Swal.fire({
          title: 'Upload File',
          width: 800,
          html: `
          <div class="mb-3">
            <label class="form-label">Select File: <span class="text-danger">*</span></label>
            <input type="file" class="form-control" id="fileInput" required>
            <small class="form-text text-muted">Maximum file size: 100MB</small>
          </div>
          
          <div class="mb-3">
            <label class="form-label">Tags:</label>
            <input type="text" class="form-control" id="tags" placeholder="e.g., Tool, Environment File, Script (comma-separated)">
            <small class="form-text text-muted">Separate multiple tags with commas</small>
          </div>
          
          <div class="mb-3">
            <label class="form-label">Description:</label>
            <textarea class="form-control" id="description" rows="3" placeholder="Describe what this file is for..."></textarea>
          </div>
          
          <div class="mb-3">
            <label class="form-label">Uploaded By:</label>
            <input type="text" class="form-control" id="uploadedBy" placeholder="Your name or identifier">
          </div>
          `,
          showCancelButton: true,
          confirmButtonText: 'Upload',
          showLoaderOnConfirm: true,
          preConfirm: () => {
            const fileInput = document.getElementById('fileInput');
            const tags = document.getElementById('tags').value.trim();
            const description = document.getElementById('description').value.trim();
            const uploadedBy = document.getElementById('uploadedBy').value.trim();
            
            if (!fileInput.files[0]) {
              Swal.showValidationMessage('Please select a file to upload');
              return false;
            }
            
            const formData = new FormData();
            formData.append('file', fileInput.files[0]);
            formData.append('tags', tags);
            formData.append('description', description);
            formData.append('uploadedBy', uploadedBy);
            
            return fetch('/files', {
              method: 'POST',
              body: formData
            }).then(response => {
              if (!response.ok) {
                return response.json().then(errorData => {
                  throw new Error(errorData.error || response.statusText);
                });
              }
              return response.json();
            }).catch(error => {
              Swal.showValidationMessage(`Upload failed: ${error.message}`);
            });
          },
          allowOutsideClick: () => !Swal.isLoading()
        }).then((result) => {
          if (result.isConfirmed) {
            Swal.fire('Success!', 'File uploaded successfully.', 'success').then(() => {
              location.reload();
            });
          }
        });
      }

      function applySearch() {
        const search = document.getElementById('searchInput').value;
        const sortField = document.getElementById('sortField').value;
        const sortOrder = document.getElementById('sortOrder').value;
        const filterTag = document.getElementById('filterTag').value;
        
        const url = new URL(window.location);
        url.searchParams.set('search', search);
        url.searchParams.set('sortBy', sortField);
        url.searchParams.set('sortOrder', sortOrder);
        url.searchParams.set('filterTag', filterTag);
        window.location.href = url.toString();
      }

      function clearFilters() {
        document.getElementById('searchInput').value = '';
        document.getElementById('filterTag').value = '';
        applySearch();
      }

      function applySorting() {
        applySearch();
      }

      function copyToClipboard(text) {
        navigator.clipboard.writeText(text).then(() => {
          Swal.fire({
            title: 'Copied!',
            text: 'URL copied to clipboard',
            icon: 'success',
            timer: 2000,
            showConfirmButton: false
          });
        }).catch(() => {
          // Fallback for older browsers
          const textArea = document.createElement('textarea');
          textArea.value = text;
          document.body.appendChild(textArea);
          textArea.select();
          document.execCommand('copy');
          document.body.removeChild(textArea);
          Swal.fire({
            title: 'Copied!',
            text: 'URL copied to clipboard',
            icon: 'success',
            timer: 2000,
            showConfirmButton: false
          });
        });
      }

      function copyCurlCommand(url, filename) {
        const curlCommand = `curl -o "${filename}" "${url}"`;
        copyToClipboard(curlCommand);
        Swal.fire({
          title: 'cURL Command Copied!',
          text: 'Ready to paste in terminal',
          icon: 'success',
          timer: 2000,
          showConfirmButton: false
        });
      }

      function showCurlInstructions() {
        Swal.fire({
          title: 'cURL Instructions',
          html: `
          <p>To download files using cURL, use:</p>
          <code>curl -o filename.ext [URL]</code>
          <br><br>
          <p>Or to preserve the original filename:</p>
          <code>curl -O [URL]</code>
          <br><br>
          <p>Click on any file's "Copy cURL" button to get the ready-to-run command.</p>
          `,
          icon: 'info'
        });
      }

      function deleteFile(id) {
        Swal.fire({
          title: 'Delete File',
          text: 'Are you sure you want to delete this file? This action cannot be undone.',
          icon: 'warning',
          showCancelButton: true,
          confirmButtonColor: '#d33',
          cancelButtonColor: '#3085d6',
          confirmButtonText: 'Yes, delete it!',
          cancelButtonText: 'Cancel'
        }).then((result) => {
          if (result.isConfirmed) {
            fetch(`/files/${id}`, {
              method: 'DELETE',
              headers: {
                'Content-Type': 'application/json'
              }
            }).then(response => {
              if (!response.ok) {
                return response.json().then(errorData => {
                  throw new Error(errorData.error || response.statusText);
                });
              }
              return response.json();
            }).then(data => {
              if (data.success) {
                Swal.fire('Deleted!', 'The file has been deleted.', 'success').then(() => {
                  location.reload();
                });
              }
            }).catch(error => {
              Swal.fire('Error!', `Failed to delete file: ${error.message}`, 'error');
            });
          }
        });
      }
      // Auto-apply filters when dropdowns change
      document.addEventListener('DOMContentLoaded', function() {
        document.getElementById('filterTag').addEventListener('change', applySearch);
        
        // Allow Enter key to trigger search
        document.getElementById('searchInput').addEventListener('keypress', function(e) {
          if (e.key === 'Enter') {
            applySearch();
          }
        });
      });
