     
doctype html
html(data-bs-theme='dark')
  head
    include head
  body
    header
      include navbar
    .container.mt-3
      .d-flex.justify-content-between.align-items-center.mb-4
        h2.text-light Credentials
        button.btn.btn-danger(type='button' onclick='addCredential();')
          i.fas.fa-plus.me-2
          | Add Credentials
      
      // Search and Filter Controls
      .row.mb-3
        .col-md-8
          .d-flex.align-items-center.mb-2
            label.form-label.text-light.me-2 Search:
            input.form-control.me-2#searchInput(type='text' placeholder='Search usernames, passwords, hashes, etc...' value=search)
            button.btn.btn-outline-secondary.me-2(onclick='applySearch()')
              i.fas.fa-search.me-1
              | Search
            button.btn.btn-outline-danger(onclick='clearFilters()')
              i.fas.fa-times.me-1
              | Clear
        .col-md-4
          .d-flex.align-items-center
            label.form-label.text-light.me-2 Sort by:
            select.form-select.me-2#sortField(style='width: auto;')
              if hasCreatedAt
                option(value='created_at' selected=currentSort.field === 'created_at') Date Added
              option(value='id' selected=currentSort.field === 'id') ID
              option(value='username' selected=currentSort.field === 'username') Username
              option(value='password' selected=currentSort.field === 'password') Password
              option(value='hash' selected=currentSort.field === 'hash') Hash
              option(value='service' selected=currentSort.field === 'service') Service
              option(value='domain' selected=currentSort.field === 'domain') Domain
              option(value='affected_host' selected=currentSort.field === 'affected_host') Affected Host
              option(value='os' selected=currentSort.field === 'os') Operating System
            select.form-select#sortOrder(style='width: auto;')
              option(value='DESC' selected=currentSort.order === 'DESC') Desc
              option(value='ASC' selected=currentSort.order === 'ASC') Asc
      
      // Filter Controls
      .row.mb-3
        .col-md-3
          .mb-2
            label.form-label.text-light Service:
            select.form-select#filterService
              option(value='') All Services
              for service in filterOptions.services
                option(value=service selected=filters.service === service)= service
        .col-md-3
          .mb-2
            label.form-label.text-light Domain:
            select.form-select#filterDomain
              option(value='') All Domains
              for domain in filterOptions.domains
                option(value=domain selected=filters.domain === domain)= domain
        .col-md-3
          .mb-2
            label.form-label.text-light OS:
            select.form-select#filterOS
              option(value='') All OS
              for os in filterOptions.os
                option(value=os selected=filters.os === os)= os
        .col-md-3
          .mb-2
            label.form-label.text-light Affected Host:
            select.form-select#filterAffectedHost
              option(value='') All Hosts
              for host in filterOptions.hosts
                option(value=host selected=filters.affectedHost === host)= host
      
      // Credentials Grid
      .row.g-3#credentialsGrid
        for credential in credentials
          .col-12.col-md-6.col-lg-4.col-xl-3
            .card.h-100.border-secondary
              .card-header.d-flex.justify-content-between.align-items-center.bg-dark.border-secondary
                .d-flex.align-items-center
                  if credential.username && credential.password
                    i.fas.fa-user-lock.text-success.me-2
                    span.badge.bg-success Combo
                  else if credential.username
                    i.fas.fa-user.text-danger.me-2
                    span.badge.bg-danger Username
                  else if credential.password
                    i.fas.fa-key.text-warning.me-2
                    span.badge.bg-warning Password
                  else if credential.hash
                    i.fas.fa-fingerprint.text-danger.me-2
                    span.badge.bg-danger Hash
                .btn-group(role='group')
                  button.btn.btn-sm.btn-outline-danger(type='button' onclick=`deleteCredential(${credential.id})`)
                    i.fas.fa-trash
                  button.btn.btn-sm.btn-outline-warning(type='button' onclick=`editCredential(${JSON.stringify(credential).replace(/'/g, "&#39;")})`)
                    i.fas.fa-edit
              
              .card-body.bg-dark
                if credential.username
                  .mb-2
                    strong.text-light Username:
                    br
                    code.text-info= credential.username
                
                if credential.password
                  .mb-2
                    strong.text-light Password:
                    br
                    code.text-info= credential.password
                
                if credential.hash
                  .mb-2
                    strong.text-light Hash:
                    br
                    code.text-info(onclick=`showFullHash('${credential.hash}', '${credential.hashType || 'Unknown'}')` style='cursor: pointer;' title='Click to view full hash')= credential.hash.length > 10 ? credential.hash.substring(0, 10) + '...' : credential.hash
                    if credential.hashType && credential.hashType !== 'Unknown'
                      br
                      small.text-muted Type: #{credential.hashType}
                
                if credential.service
                  .mb-2
                    strong.text-light Service:
                    br
                    span.badge.bg-secondary= credential.service
                
                if credential.domain
                  .mb-2
                    strong.text-light Domain:
                    br
                    span.text-warning= credential.domain
                
                if credential.affected_host
                  .mb-2
                    strong.text-light Affected Host:
                    br
                    span.text-info= credential.affected_host
                
                if credential.os
                  .mb-2
                    strong.text-light OS:
                    br
                    span.badge.bg-info= credential.os
                
                if credential.notes
                  .mb-2
                    strong.text-light Notes:
                    br
                    small.text-muted= credential.notes
                
                if credential.created_at
                  .mb-2
                    strong.text-light Added:
                    br
                    small.text-muted= new Date(credential.created_at).toLocaleString()
                else
                  .mb-2
                    strong.text-light ID:
                    br
                    small.text-muted= credential.id
                
                if credential.host_id
                  .mb-2
                    strong.text-light Host ID:
                    br
                    span.text-muted= credential.host_id

      // Empty state
      if credentials.length === 0
        .text-center.py-5
          i.fas.fa-key.fa-3x.text-muted.mb-3
          h4.text-muted No credentials found
          p.text-muted Click "Add Credentials" to get started

    include scripts
    script.
      function addCredential() {
        Swal.fire({
          title: 'Add New Credential',
          width: 900,
          html: `
          <div class="row">
            <div class="col-md-6">
              <div class="mb-3">
                <label class="form-label">Username:</label>
                <input type="text" class="form-control" id="username" placeholder="Enter username">
              </div>
            </div>
            <div class="col-md-6">
              <div class="mb-3">
                <label class="form-label">Password:</label>
                <input type="text" class="form-control" id="password" placeholder="Enter password">
              </div>
            </div>
          </div>
          
          <div class="mb-3">
            <label class="form-label">Hash:</label>
            <input type="text" class="form-control" id="hash" placeholder="Enter hash (optional)">
          </div>
          
          <div class="row">
            <div class="col-md-6">
              <div class="mb-3">
                <label class="form-label">Service:</label>
                <input type="text" class="form-control" id="service" placeholder="e.g., SSH, RDP, HTTP">
              </div>
            </div>
            <div class="col-md-6">
              <div class="mb-3">
                <label class="form-label">Domain:</label>
                <input type="text" class="form-control" id="domain" placeholder="e.g., WORKGROUP, DOMAIN">
              </div>
            </div>
          </div>
          
          <div class="row">
            <div class="col-md-6">
              <div class="mb-3">
                <label class="form-label">Affected Host:</label>
                <input type="text" class="form-control" id="affected_host" placeholder="e.g., 192.168.1.100, hostname">
              </div>
            </div>
            <div class="col-md-6">
              <div class="mb-3">
                <label class="form-label">Operating System:</label>
                <input type="text" class="form-control" id="os" placeholder="e.g., Windows 10, Ubuntu 20.04">
              </div>
            </div>
          </div>
          
          <div class="mb-3">
            <label class="form-label">Notes:</label>
            <textarea class="form-control" id="notes" rows="2" placeholder="Additional notes about this credential"></textarea>
          </div>
          `,
          showCancelButton: true,
          confirmButtonText: 'Add Credential',
          showLoaderOnConfirm: true,
          preConfirm: () => {
            const username = document.getElementById('username').value.trim();
            const password = document.getElementById('password').value.trim();
            const hash = document.getElementById('hash').value.trim();
            const service = document.getElementById('service').value.trim();
            const domain = document.getElementById('domain').value.trim();
            const affected_host = document.getElementById('affected_host').value.trim();
            const os = document.getElementById('os').value.trim();
            const notes = document.getElementById('notes').value.trim();
            
            // Validation - at least one of username or password must be provided
            if (!username && !password) {
              Swal.showValidationMessage('At least one of username or password must be provided');
              return false;
            }
            
            // Determine credential type based on what's provided
            let credentialType;
            if (username && password) {
              credentialType = 'combo';
            } else if (username && !password) {
              credentialType = 'username';
            } else if (!username && password) {
              credentialType = 'password';
            }
            
            const requestData = {
              credentialType,
              username: username || undefined,
              password: password || undefined,
              hash: hash || undefined,
              service: service || undefined,
              domain: domain || undefined,
              affected_host: affected_host || undefined,
              os: os || undefined,
              notes: notes || undefined
            };
            
            return fetch(`/credentials`, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json'
              },
              body: JSON.stringify(requestData)
            }).then(response => {
              if (!response.ok) {
                return response.json().then(errorData => {
                  throw new Error(errorData.error || response.statusText);
                });
              }
              return response.json();
            }).catch(error => {
              Swal.showValidationMessage(`Request failed: ${error.message}`);
            });
          },
          allowOutsideClick: () => !Swal.isLoading()
        }).then((result) => {
          if (result.isConfirmed) {
            location.reload();
          }
        });
      }

      function editCredential(credential) {
        Swal.fire({
          title: 'Edit Credential',
          width: 900,
          html: `
          <div class="row">
            <div class="col-md-6">
              <div class="mb-3">
                <label class="form-label">Username:</label>
                <input type="text" class="form-control" id="edit_username" value="${credential.username || ''}" placeholder="Enter username">
              </div>
            </div>
            <div class="col-md-6">
              <div class="mb-3">
                <label class="form-label">Password:</label>
                <input type="text" class="form-control" id="edit_password" value="${credential.password || ''}" placeholder="Enter password">
              </div>
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label">Hash:</label>
            <input type="text" class="form-control" id="edit_hash" value="${credential.hash || ''}" placeholder="Enter hash (optional)">
          </div>
          <div class="row">
            <div class="col-md-6">
              <div class="mb-3">
                <label class="form-label">Service:</label>
                <input type="text" class="form-control" id="edit_service" value="${credential.service || ''}" placeholder="e.g., SSH, RDP, HTTP">
              </div>
            </div>
            <div class="col-md-6">
              <div class="mb-3">
                <label class="form-label">Domain:</label>
                <input type="text" class="form-control" id="edit_domain" value="${credential.domain || ''}" placeholder="e.g., WORKGROUP, DOMAIN">
              </div>
            </div>
          </div>
          <div class="row">
            <div class="col-md-6">
              <div class="mb-3">
                <label class="form-label">Affected Host:</label>
                <input type="text" class="form-control" id="edit_affected_host" value="${credential.affected_host || ''}" placeholder="e.g., 192.168.1.100, hostname">
              </div>
            </div>
            <div class="col-md-6">
              <div class="mb-3">
                <label class="form-label">Operating System:</label>
                <input type="text" class="form-control" id="edit_os" value="${credential.os || ''}" placeholder="e.g., Windows 10, Ubuntu 20.04">
              </div>
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label">Notes:</label>
            <textarea class="form-control" id="edit_notes" rows="2" placeholder="Additional notes about this credential">${credential.notes || ''}</textarea>
          </div>
          `,
          showCancelButton: true,
          confirmButtonText: 'Save Changes',
          showLoaderOnConfirm: true,
          preConfirm: () => {
            const username = document.getElementById('edit_username').value.trim();
            const password = document.getElementById('edit_password').value.trim();
            const hash = document.getElementById('edit_hash').value.trim();
            const service = document.getElementById('edit_service').value.trim();
            const domain = document.getElementById('edit_domain').value.trim();
            const affected_host = document.getElementById('edit_affected_host').value.trim();
            const os = document.getElementById('edit_os').value.trim();
            const notes = document.getElementById('edit_notes').value.trim();
            if (!username && !password) {
              Swal.showValidationMessage('At least one of username or password must be provided');
              return false;
            }
            let credentialType;
            if (username && password) {
              credentialType = 'combo';
            } else if (username && !password) {
              credentialType = 'username';
            } else if (!username && password) {
              credentialType = 'password';
            }
            const requestData = {
              credentialType,
              username: username || undefined,
              password: password || undefined,
              hash: hash || undefined,
              service: service || undefined,
              domain: domain || undefined,
              affected_host: affected_host || undefined,
              os: os || undefined,
              notes: notes || undefined
            };
            return fetch(`/credentials/${credential.id}`, {
              method: 'PUT',
              headers: {
                'Content-Type': 'application/json'
              },
              body: JSON.stringify(requestData)
            }).then(response => {
              if (!response.ok) {
                return response.json().then(errorData => {
                  throw new Error(errorData.error || response.statusText);
                });
              }
              return response.json();
            }).catch(error => {
              Swal.showValidationMessage(`Update failed: ${error.message}`);
            });
          },
          allowOutsideClick: () => !Swal.isLoading()
        }).then((result) => {
          if (result.isConfirmed) {
            location.reload();
          }
        });
      }

      function applySearch() {
        const search = document.getElementById('searchInput').value;
        const sortField = document.getElementById('sortField').value;
        const sortOrder = document.getElementById('sortOrder').value;
        const filterService = document.getElementById('filterService').value;
        const filterDomain = document.getElementById('filterDomain').value;
        const filterOS = document.getElementById('filterOS').value;
        const filterAffectedHost = document.getElementById('filterAffectedHost').value;
        
        const url = new URL(window.location);
        url.searchParams.set('search', search);
        url.searchParams.set('sortBy', sortField);
        url.searchParams.set('sortOrder', sortOrder);
        url.searchParams.set('filterService', filterService);
        url.searchParams.set('filterDomain', filterDomain);
        url.searchParams.set('filterOS', filterOS);
        url.searchParams.set('filterAffectedHost', filterAffectedHost);
        window.location.href = url.toString();
      }

      function clearFilters() {
        document.getElementById('searchInput').value = '';
        document.getElementById('filterService').value = '';
        document.getElementById('filterDomain').value = '';
        document.getElementById('filterOS').value = '';
        document.getElementById('filterAffectedHost').value = '';
        applySearch();
      }

      function applySorting() {
        applySearch(); // Use the same function to maintain all filters
      }

      // Auto-apply filters when dropdowns change
      document.addEventListener('DOMContentLoaded', function() {
        document.getElementById('filterService').addEventListener('change', applySearch);
        document.getElementById('filterDomain').addEventListener('change', applySearch);
        document.getElementById('filterOS').addEventListener('change', applySearch);
        document.getElementById('filterAffectedHost').addEventListener('change', applySearch);
        
        // Allow Enter key to trigger search
        document.getElementById('searchInput').addEventListener('keypress', function(e) {
          if (e.key === 'Enter') {
            applySearch();
          }
        });
      });

      function showFullHash(hash, hashType) {
        Swal.fire({
          title: 'Full Hash',
          html: `
            <div class="text-start">
              <p><strong>Hash Type:</strong> ${hashType}</p>
              <p><strong>Full Hash:</strong></p>
              <div class="bg-dark p-3 rounded" style="word-break: break-all; font-family: monospace; font-size: 0.9em;">
                ${hash}
              </div>
              <button class="btn btn-primary btn-sm mt-2" onclick="copyToClipboard('${hash}')">
                <i class="fas fa-copy me-1"></i> Copy Hash
              </button>
            </div>
          `,
          width: 600,
          showCancelButton: true,
          confirmButtonText: 'Close',
          cancelButtonText: 'Copy Hash',
          cancelButtonColor: '#3085d6',
          confirmButtonColor: '#6c757d'
        }).then((result) => {
          if (result.dismiss === Swal.DismissReason.cancel) {
            copyToClipboard(hash);
          }
        });
      }

      function copyToClipboard(text) {
        navigator.clipboard.writeText(text).then(() => {
          Swal.fire('Copied!', 'Hash copied to clipboard', 'success');
        }).catch(err => {
          // Fallback for older browsers
          const textArea = document.createElement('textarea');
          textArea.value = text;
          document.body.appendChild(textArea);
          textArea.select();
          document.execCommand('copy');
          document.body.removeChild(textArea);
          Swal.fire('Copied!', 'Hash copied to clipboard', 'success');
        });
      }

      function deleteCredential(id) {
        Swal.fire({
          title: 'Delete Credential',
          text: 'Are you sure you want to delete this credential? This action cannot be undone.',
          icon: 'warning',
          showCancelButton: true,
          confirmButtonColor: '#d33',
          cancelButtonColor: '#3085d6',
          confirmButtonText: 'Yes, delete it!',
          cancelButtonText: 'Cancel'
        }).then((result) => {
          if (result.isConfirmed) {
            fetch(`/credentials/${id}`, {
              method: 'DELETE',
              headers: {
                'Content-Type': 'application/json'
              }
            }).then(response => {
              if (!response.ok) {
                return response.json().then(errorData => {
                  throw new Error(errorData.error || response.statusText);
                });
              }
              return response.json();
            }).then(data => {
              if (data.success) {
                Swal.fire('Deleted!', 'The credential has been deleted.', 'success').then(() => {
                  location.reload();
                });
              }
            }).catch(error => {
              Swal.fire('Error!', `Failed to delete credential: ${error.message}`, 'error');
            });
          }
        });
      }

